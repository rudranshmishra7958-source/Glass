",\\n    \\\"scripting\\\"\\n  ],\\n  \\\"host_permissions\\\": [\\n    \\\"<all_urls>\\\"\\n  ],\\n  \\\"content_scripts\\\": [\\n    {\\n      \\\"matches\\\": [\\\"<all_urls>\\\"],\\n      \\\"js\\\": [\\\"content.js\\\"],\\n      \\\"css\\\": [\\\"content.css\\\"],\\n      \\\"run_at\\\": \\\"document_idle\\\"\\n    }\\n  ],\\n  \\\"content_security_policy\\\": {\\n    \\\"extension_pages\\\": \\\"script-src 'self'; object-src 'self'; connect-src 'none';\\\"\\n  }\\n}\\n\"","Description":"\"Remove static icon file requirements from manifest.json to allow immediate loading\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\vijay\\\\.gemini\\\\antigravity\\\\scratch\\\\offline-vault-extension\\\\manifest.json\"","toolAction":"\"Updating manifest.json\"","toolSummary":"\"Fix icon error in manifest.json\""}}]}

ssInput.value);\n          strengthBox.style.display = 'block';\n          strengthBox.innerHTML = `\n            <div class=\"strength-meter\">\n              <div class=\"strength-bar ${s.score >= 1 ? (s.score === 1 ? 'weak' : s.score === 2 ? 'medium' : 'strong') : ''}\"></div>\n              <div class=\"strength-bar ${s.score >= 2 ? (s.score === 2 ? 'medium' : 'strong') : ''}\"></div>\n              <div class=\"strength-bar ${s.score >= 3 ? 'strong' : ''}\"></div>\n              <div class=\"strength-bar ${s.score >= 4 ? 'strong' : ''}\"></div>\n            </div>\n            <div style=\"font-size:0.75rem;color:${s.color};margin-top:2px;\">Strength: ${s.label} (${s.bits} bits)</div>`;\n        };\n      }\n\n      form.onsubmit = async (e) => {\n        e.preventDefault();\n        const pwd = passInput.value;\n        const triggerErr = (msg) => {\n          errBox.textContent = msg;\n          errBox.style.display = 'block';\n          card.classList.add('shake');\n          setTimeout(() => card.classList.remove('shake'), 400);\n        };\n\n        if (isSetup) {\n          if (pwd.length < 8) return triggerErr('Password must be at least 8 characters.');\n          if (pwd !== confirmInput.value) return triggerErr('Passwords do not match.');\n\n          const salt = generateSalt(16);\n          const key = await deriveMasterKey(pwd, salt);\n          const canary = await encryptPayload({ canary: CANARY_SECRET }, key);\n          const meta = { salt, canary, autoLockMinutes: 15, createdAt: new Date().toISOString() };\n          await saveStoredMeta(meta);\n          state.meta = meta;\n          state.masterKey = key;\n          state.items = [];\n          state.vaultStatus = 'unlocked';\n          showToast('Vault created successfully!');\n          render();\n        } else {\n          try {\n            const key = await deriveMasterKey(pwd, state.meta.salt);\n            const verified = await decryptPayload(state.meta.canary, key);\n            if (!verified || verified.canary !== CANARY_SECRET) throw new Error('Bad key');\n\n            // Decrypt items\n            const encryptedItems = await getStoredItems();\n            const decrypted = [];\n            for (const item of encryptedItems) {\n              try {\n                const payload = await decryptPayload({ ciphertext: item.ciphertext, iv: item.iv }, key);\n                decrypted.push({ id: item.id, category: item.category || 'logins', favorite: !!item.favorite, updatedAt: item.updatedAt, ...payload });\n              } catch (e) { console.error(e); }\n            }\n            state.masterKey = key;\n            state.items = decrypted;\n            state.vaultStatus = 'unlocked';\n            showToast('Vault unlocked.');\n            render();\n          } catch (err) {\n            triggerErr('Incorrect master password. Please try again.');\n          }\n        }\n      };\n    }\n\n    function renderDashboard(container) {\n      // Calculate counts\n      const counts = { all: state.items.length, favorites: 0, logins: 0, cards: 0, notes: 0 };\n      let weakCount = 0;\n      const pwdMap = {};\n      state.items.forEach(i => {\n        if (i.favorite) counts.favorites++;\n        if (counts[i.category] !== undefined) counts[i.category]++;\n        if (i.category === 'logins' && i.password) {\n          if (i.password.length < 12) weakCount++;\n          pwdMap[i.password] = (pwdMap[i.password] || 0) + 1;\n        }\n      });\n      const reusedCount = Object.values(pwdMap).filter(c => c > 1).length;\n      const totalAlerts = weakCount + reusedCount;\n\n      // Filtered items\n      const filtered = state.items.filter(item => {\n        if (state.activeCategory === 'favorites' && !item.favorite) return false;\n        if (state.activeCategory !== 'all' && state.activeCategory !== 'favorites' && item.category !== state.activeCategory) return false;\n        if (state.searchQuery) {\n          const q = state.searchQuery.toLowerCase();\n          return (item.title || '').toLowerCase().includes(q) ||\n                 (item.username || '').toLowerCase().includes(q) ||\n                 (item.url || '').toLowerCase().includes(q) ||\n                 (item.notes || '').toLowerCase().includes(q);\n        }\n        return true;\n      });\n\n      container.innerHTML = `\n        <header class=\"navbar\">\n          <div class=\"nav-brand\">\n            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"2\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>\n            <span>Offline Vault</span>\n          </div>\n          <div class=\"nav-search\">\n            <span class=\"search-icon-pos\">\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg>\n            </span>\n            <input type=\"text\" id=\"nav-search-input\" placeholder=\"Search logins, cards, notes...\" value=\"${escapeHtml(state.searchQuery)}\" />\n          </div>\n          <div class=\"nav-actions\">\n            <button class=\"btn btn-secondary\" id=\"btn-open-gen\">✨ Generator</button>\n            <button class=\"btn btn-secondary\" id=\"btn-open-audit\">\n              🛡️ Health ${totalAlerts > 0 ? `<span style=\"background:var(--danger);color:white;font-size:0.7rem;padding:1px 6px;border-radius:9999px;margin-left:4px;\">${totalAlerts}</span>` : ''}\n            </button>\n            <button class=\"btn btn-primary\" id=\"btn-new-item\">＋ New Item</button>\n            <button class=\"btn-icon\" id=\"btn-open-settings\" title=\"Settings\">⚙️</button>\n            <button class=\"btn btn-danger\" id=\"btn-lock-vault\">🔒 Lock</button>\n          </div>\n        </header>\n\n        <div class=\"main-layout\">\n          <aside class=\"sidebar\">\n            <div>\n              <div class=\"sidebar-heading\">Categories</div>\n              <div class=\"sidebar-nav\">\n                ${[\n                  { id: 'all', label: 'All Items', icon: '🔑', count: counts.all },\n                  { id: 'favorites', label: 'Favorites', icon: '⭐', count: counts.favorites },\n                  { id: 'logins', label: 'Logins', icon: '🌐', count: counts.logins },\n                  { id: 'cards', label: 'Cards', icon: '💳', count: counts.cards },\n                  { id: 'notes', label: 'Secure Notes', icon: '📝', count: counts.notes }\n                ].map(cat => `\n                  <button class=\"sidebar-item ${state.activeCategory === cat.id ? 'active' : ''}\" data-cat=\"${cat.id}\">\n                    <div style=\"display:flex;align-items:center;gap:0.75rem;\">\n                      <span>${cat.icon}</span><span>${cat.label}</span>\n                    </div>\n                    <span class=\"badge\">${cat.count}</span>\n                  </button>\n                `).join('')}\n              </div>\n            </div>\n\n            <div style=\"margin-top:auto;border-top:1px solid var(--border-color);padding-top:1rem;\">\n              <div style=\"background:var(--bg-input);padding:0.75rem;border-radius:var(--radius-md);font-size:0.78rem;color:var(--text-secondary);\">\n                <div style=\"color:var(--primary);font-weight:600;display:flex;align-items:center;gap:6px;margin-bottom:4px;\">\n                  <span style=\"width:8px;height:8px;border-radius:50%;background:var(--primary);display:inline-block;\"></span>\n                  100% Offline\n                </div>\n                IndexedDB AES-256 encrypted. Zero network connection.\n              </div>\n            </div>\n          </aside>\n\n          <main class=\"content-area\">\n            <div class=\"content-header\">\n              <div>\n                <h2 class=\"content-title\">${state.activeCategory.toUpperCase()}</h2>\n                <span style=\"color:var(--text-muted);font-size:0.85rem;\">${filtered.length} items found</span>\n              </div>\n              <button class=\"btn btn-primary\" id=\"btn-new-item-2\">＋ Add Item</button>\n            </div>\n\n            ${filtered.length === 0 ? `\n              <div style=\"padding:4rem 2rem;text-align:center;border:1px dashed var(--border-color);border-radius:var(--radius-lg);color:var(--text-muted);\">\n                <p style=\"font-size:1.1rem;color:var(--text-primary);margin-bottom:0.5rem;\">No items found</p>\n                <p style=\"font-size:0.9rem;margin-bottom:1rem;\">Add your first encrypted credential to get started.</p>\n                <button class=\"btn btn-primary\" id=\"btn-empty-add\">＋ Add First Item</button>\n              </div>\n            ` : `\n              <div class=\"items-grid\">\n                ${filtered.map(item => renderItemCard(item)).join('')}\n              </div>\n            `}\n          </main>\n        </div>\n\n        <div id=\"modal-container\"></div>\n      `;\n\n      // Wire Dashboard Events\n      document.getElementById('nav-search-input').oninput = (e) => {\n        state.searchQuery = e.target.value;\n        renderDashboard(container);\n      };\n\n      document.querySelectorAll('.sidebar-item[data-cat]').forEach(btn => {\n        btn.onclick = () => {\n          state.activeCategory = btn.getAttribute('data-cat');\n          renderDashboard(container);\n        };\n      });\n\n      const openAdd = () => openItemModal(null);\n      document.getElementById('btn-new-item').onclick = openAdd;\n      document.getElementById('btn-new-item-2').onclick = openAdd;\n      if (document.getElementById('btn-empty-add')) document.getElementById('btn-empty-add').onclick = openAdd;\n\n      document.getElementById('btn-lock-vault').onclick = lockVault;\n      document.getElementById('btn-open-gen').onclick = openGeneratorModal;\n      document.getElementById('btn-open-settings').onclick = openSettingsModal;\n      document.getElementById('btn-open-audit').onclick = openAuditModal;\n\n      // Item Card Buttons (Copy, Star, Reveal, Edit, Delete)\n      document.querySelectorAll('[data-action]').forEach(btn => {\n        const action = btn.getAttribute('data-action');\n        const id = btn.getAttribute('data-id');\n        const item = state.items.find(i => i.id === id);\n\n        if (action === 'toggle-star') {\n          btn.onclick = async () => {\n            item.favorite = !item.favorite;\n            await saveStoredItem({ ...item, ...await encryptPayload(getCleanSecret(item), state.masterKey) });\n            renderDashboard(container);\n          };\n        } else if (action === 'reveal-pass') {\n          btn.onclick = () => {\n            state.revealedPasswords[id] = !state.revealedPasswords[id];\n            renderDashboard(container);\n          };\n        } else if (action === 'copy') {\n          btn.onclick = () => {\n            const val = btn.getAttribute('data-val');\n            navigator.clipboard.writeText(val);\n            showToast('Copied to clipboard!');\n          };\n        } else if (action === 'edit') {\n          btn.onclick = () => openItemModal(item);\n        } else if (action === 'delete') {\n          btn.onclick = async () => {\n            if (confirm(`Delete \"${item.title}\"?`)) {\n              await deleteStoredItem(item.id);\n              state.items = state.items.filter(i => i.id !== id);\n              renderDashboard(container);\n              showToast('Item deleted.');\n            }\n          };\n        }\n      });\n    }\n\n    function renderItemCard(item) {\n      const isRevealed = !!state.revealedPasswords[item.id];\n      const icon = item.category === 'cards' ? '💳' : item.category === 'notes' ? '📝' : '🌐';\n\n      return `\n        <div class=\"item-card\">\n          <div class=\"item-card-header\">\n            <div class=\"item-title-wrap\">\n              <div class=\"item-category-icon\">${icon}</div>\n              <div>\n                <h3 class=\"item-title\">${escapeHtml(item.title || 'Untitled')}</h3>\n                ${item.url ? `<a href=\"${escapeHtml(item.url.startsWith('http') ? item.url : 'https://' + item.url)}\" target=\"_blank\" rel=\"noreferrer\" style=\"color:var(--text-muted);font-size:0.78rem;text-decoration:none;\">${escapeHtml(item.url.replace(/^https?:\\/\\//, '').replace(/\\/.*$/, ''))} ↗</a>` : ''}\n              </div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:4px;\">\n              <button class=\"btn-icon\" data-action=\"toggle-star\" data-id=\"${item.id}\" style=\"color:${item.favorite ? 'var(--warning)' : 'var(--text-muted)'};\">\n                ${item.favorite ? '★' : '☆'}\n              </button>\n              <button class=\"btn-icon\" data-action=\"edit\" data-id=\"${item.id}\" title=\"Edit\">✏️</button>\n              <button class=\"btn-icon\" data-action=\"delete\" data-id=\"${item.id}\" title=\"Delete\" style=\"color:var(--danger)\">🗑️</button>\n            </div>\n          </div>\n\n          <div class=\"item-fields\">\n            ${item.category === 'logins' ? `\n              ${item.username ? `\n                <div class=\"field-row\">\n                  <span class=\"field-label\">User</span>\n                  <span class=\"field-value\">${escapeHtml(item.username)}</span>\n                  <button class=\"btn-icon\" style=\"padding:2px;\" data-action=\"copy\" data-val=\"${escapeHtml(item.username)}\">📋</button>\n                </div>\n              ` : ''}\n              ${item.password ? `\n                <div class=\"field-row\">\n                  <span class=\"field-label\">Pass</span>\n                  <span class=\"field-value\" style=\"letter-spacing:${isRevealed ? 'normal' : '2px'}\">${escapeHtml(isRevealed ? item.password : '••••••••••••')}</span>\n                  <button class=\"btn-icon\" style=\"padding:2px;\" data-action=\"reveal-pass\" data-id=\"${item.id}\">${isRevealed ? '🙈' : '👁️'}</button>\n                  <button class=\"btn-icon\" style=\"padding:2px;\" data-action=\"copy\" data-val=\"${escapeHtml(item.password)}\">📋</button>\n                </div>\n              ` : ''}\n            ` : item.category === 'cards' ? `\n              <div class=\"field-row\">\n                <span class=\"field-label\">Card</span>\n                <span class=\"field-value\">${isRevealed ? escapeHtml(item.cardNumber || '') : '•••• •••• •••• ' + (item.cardNumber || '').slice(-4)}</span>\n                <button class=\"btn-icon\" style=\"padding:2px;\" data-action=\"reveal-pass\" data-id=\"${item.id}\">${isRevealed ? '🙈' : '👁️'}</button>\n                <button class=\"btn-icon\" style=\"padding:2px;\" data-action=\"copy\" data-val=\"${escapeHtml(item.cardNumber || '')}\">📋</button>\n              </div>\n              <div class=\"field-row\">\n                <span class=\"field-label\">Exp / CVV</span>\n                <span class=\"field-value\">${escapeHtml(item.expiry || '--/--')} | ${isRevealed ? escapeHtml(item.cvv || '---') : '•••'}</span>\n              </div>\n            ` : `\n              <div style=\"font-size:0.85rem;white-space:pre-wrap;max-height:100px;overflow-y:auto;color:var(--text-primary);\">\n                ${escapeHtml(item.notes || 'Empty note')}\n              </div>\n            `}\n          </div>\n\n          <div class=\"item-card-footer\">\n            <span>${item.updatedAt ? new Date(item.updatedAt).toLocaleDateString() : 'Today'}</span>\n            <span style=\"text-transform:capitalize;\">${item.category}</span>\n          </div>\n        </div>\n      `;\n    }\n\n    function getCleanSecret(item) {\n      const { id, category, favorite, updatedAt, createdAt, ...rest } = item;\n      return rest;\n    }\n\n    function escapeHtml(str) {\n      if (!str) return '';\n      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n    }\n\n    // --- MODALS ---\n    function openItemModal(editingItem) {\n      const modalCont = document.getElementById('modal-container');\n      const isEdit = !!editingItem;\n      const cat = editingItem ? editingItem.category : 'logins';\n\n      modalCont.innerHTML = `\n        <div class=\"modal-overlay\" id=\"item-modal-overlay\">\n          <div class=\"modal-card\" onclick=\"event.stopPropagation()\">\n            <div class=\"modal-header\">\n              <span>${isEdit ? 'Edit Item' : 'New Vault Item'}</span>\n              <button class=\"btn-icon\" id=\"item-modal-close\">✕</button>\n            </div>\n            <form id=\"item-modal-form\">\n              <div class=\"modal-body\">\n                ${!isEdit ? `\n                  <div style=\"display:flex;gap:0.5rem;background:var(--bg-input);padding:0.25rem;border-radius:var(--radius-md);\">\n                    <button type=\"button\" class=\"btn ${cat === 'logins' ? 'btn-primary' : 'btn-secondary'}\" style=\"flex:1\" id=\"tab-logins\">🌐 Login</button>\n                    <button type=\"button\" class=\"btn ${cat === 'cards' ? 'btn-primary' : 'btn-secondary'}\" style=\"flex:1\" id=\"tab-cards\">💳 Card</button>\n                    <button type=\"button\" class=\"btn ${cat === 'notes' ? 'btn-primary' : 'btn-secondary'}\" style=\"flex:1\" id=\"tab-notes\">📝 Note</button>\n                  </div>\n                ` : ''}\n\n                <div class=\"form-group\">\n                  <label class=\"form-label\">Title *</label>\n                  <input type=\"text\" id=\"m-title\" class=\"form-input\" placeholder=\"e.g. GitHub, Google, Wi-Fi\" value=\"${escapeHtml(editingItem?.title || '')}\" required />\n                </div>\n\n                <div id=\"dynamic-fields\"></div>\n\n                <div class=\"form-group\">\n                  <label class=\"form-label\">Private Notes (Encrypted)</label>\n                  <textarea id=\"m-notes\" class=\"form-textarea\" rows=\"3\" placeholder=\"Optional notes...\">${escapeHtml(editingItem?.notes || '')}</textarea>\n                </div>\n              </div>\n\n              <div class=\"modal-footer\">\n                <button type=\"button\" class=\"btn btn-secondary\" id=\"item-modal-cancel\">Cancel</button>\n                <button type=\"submit\" class=\"btn btn-primary\">${isEdit ? 'Save Changes' : 'Encrypt & Save'}</button>\n              </div>\n            </form>\n          </div>\n        </div>\n      `;\n\n      let currentCat = cat;\n      const dynContainer = document.getElementById('dynamic-fields');\n\n      function updateCategoryFields(c) {\n        currentCat = c;\n        if (c === 'logins') {\n          dynContainer.innerHTML = `\n            <div class=\"form-group\">\n              <label class=\"form-label\">Username / Email</label>\n              <input type=\"text\" id=\"m-user\" class=\"form-input\" placeholder=\"user@example.com\" value=\"${escapeHtml(editingItem?.username || '')}\" />\n            </div>\n            <div class=\"form-group\">\n              <div style=\"display:flex;justify-content:space-between;\">\n                <label class=\"form-label\">Password</label>\n                <button type=\"button\" id=\"m-quick-gen\" style=\"background:none;border:none;color:var(--primary);cursor:pointer;font-size:0.8rem;\">✨ Generate</button>\n              </div>\n              <div class=\"input-with-action\">\n                <input type=\"password\" id=\"m-pass\" class=\"form-input\" placeholder=\"Password\" value=\"${escapeHtml(editingItem?.password || '')}\" />\n                <div class=\"input-action-buttons\">\n                  <button type=\"button\" class=\"btn-icon\" id=\"m-eye\">👁️</button>\n                </div>\n              </div>\n            </div>\n            <div class=\"form-group\">\n              <label class=\"form-label\">Website URL</label>\n              <input type=\"text\" id=\"m-url\" class=\"form-input\" placeholder=\"https://...\" value=\"${escapeHtml(editingItem?.url || '')}\" />\n            </div>\n          `;\n          document.getElementById('m-eye').onclick = () => {\n            const p = document.getElementById('m-pass');\n            p.type = p.type === 'password' ? 'text' : 'password';\n          };\n          document.getElementById('m-quick-gen').onclick = () => {\n            const p = document.getElementById('m-pass');\n            p.value = generateSecurePassword({ length: 20 });\n            p.type = 'text';\n            showToast('Generated strong password!');\n          };\n        } else if (c === 'cards') {\n          dynContainer.innerHTML = `\n            <div class=\"form-group\">\n              <label class=\"form-label\">Cardholder Name</label>\n              <input type=\"text\" id=\"m-cardholder\" class=\"form-input\" value=\"${escapeHtml(editingItem?.cardholder || '')}\" />\n            </div>\n            <div class=\"form-group\">\n              <label class=\"form-label\">Card Number</label>\n              <input type=\"text\" id=\"m-cardnum\" class=\"form-input\" placeholder=\"4000 1234 5678 9010\" value=\"${escapeHtml(editingItem?.cardNumber || '')}\" />\n            </div>\n            <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;\">\n              <div class=\"form-group\">\n                <label class=\"form-label\">Expires (MM/YY)</label>\n                <input type=\"text\" id=\"m-exp\" class=\"form-input\" placeholder=\"12/28\" value=\"${escapeHtml(editingItem?.expiry || '')}\" />\n              </div>\n              <div class=\"form-group\">\n                <label class=\"form-label\">CVV</label>\n                <input type=\"password\" id=\"m-cvv\" class=\"form-input\" placeholder=\"123\" value=\"${escapeHtml(editingItem?.cvv || '')}\" />\n              </div>\n            </div>\n          `;\n        } else {\n          dynContainer.innerHTML = '';\n        }\n      }\n\n      updateCategoryFields(cat);\n\n      if (!isEdit) {\n        ['logins', 'cards', 'notes'].forEach(t => {\n          document.getElementById(`tab-${t}`).onclick = () => {\n            ['logins', 'cards', 'notes'].forEach(x => {\n              document.getElementById(`tab-${x}`).className = x === t ? 'btn btn-primary' : 'btn btn-secondary';\n            });\n            updateCategoryFields(t);\n          };\n        });\n      }\n\n      const close = () => { modalCont.innerHTML = ''; };\n      document.getElementById('item-modal-close').onclick = close;\n      document.getElementById('item-modal-cancel').onclick = close;\n      document.getElementById('item-modal-overlay').onclick = close;\n\n      document.getElementById('item-modal-form').onsubmit = async (e) => {\n        e.preventDefault();\n        const title = document.getElementById('m-title').value.trim();\n        const notes = document.getElementById('m-notes').value.trim();\n        const secret = { title, notes };\n\n        if (currentCat === 'logins') {\n          secret.username = document.getElementById('m-user').value.trim();\n          secret.password = document.getElementById('m-pass').value;\n          secret.url = document.getElementById('m-url').value.trim();\n        } else if (currentCat === 'cards') {\n          secret.cardholder = document.getElementById('m-cardholder').value.trim();\n          secret.cardNumber = document.getElementById('m-cardnum').value.trim();\n          secret.expiry = document.getElementById('m-exp').value.trim();\n          secret.cvv = document.getElementById('m-cvv').value.trim();\n        }\n\n        const encrypted = await encryptPayload(secret, state.masterKey);\n        const id = editingItem ? editingItem.id : Date.now().toString(36) + Math.random().toString(36).slice(2, 6);\n        const record = {\n          id,\n          category: currentCat,\n          favorite: editingItem ? editingItem.favorite : false,\n          ciphertext: encrypted.ciphertext,\n          iv: encrypted.iv,\n          createdAt: editingItem?.createdAt || new Date().toISOString(),\n          updatedAt: new Date().toISOString()\n        };\n\n        await saveStoredItem(record);\n        if (editingItem) {\n          state.items = state.items.map(i => i.id === id ? { ...record, ...secret } : i);\n        } else {\n          state.items.unshift({ ...record, ...secret });\n        }\n\n        close();\n        renderDashboard(document.getElementById('app'));\n        showToast(isEdit ? 'Item updated!' : 'Item encrypted & saved!');\n      };\n    }\n\n    function openGeneratorModal() {\n      const modalCont = document.getElementById('modal-container');\n      modalCont.innerHTML = `\n        <div class=\"modal-overlay\" id=\"gen-modal-overlay\">\n          <div class=\"modal-card\" onclick=\"event.stopPropagation()\" style=\"max-width:480px;\">\n            <div class=\"modal-header\">\n              <span>✨ Password Generator</span>\n              <button class=\"btn-icon\" id=\"gen-modal-close\">✕</button>\n            </div>\n            <div class=\"modal-body\">\n              <div style=\"background:var(--bg-input);padding:1rem;border-radius:var(--radius-md);display:flex;justify-content:space-between;align-items:center;\">\n                <span id=\"gen-display\" style=\"font-family:monospace;font-size:1.2rem;letter-spacing:1px;word-break:break-all;\"></span>\n                <div style=\"display:flex;gap:4px;\">\n                  <button class=\"btn-icon\" id=\"btn-regen\">🔄</button>\n                  <button class=\"btn-icon\" id=\"btn-copy-gen\" style=\"color:var(--primary);\">📋</button>\n                </div>\n              </div>\n              <div id=\"gen-strength-box\"></div>\n              <div class=\"form-group\">\n                <div style=\"display:flex;justify-content:space-between;\">\n                  <label class=\"form-label\">Length</label>\n                  <span id=\"gen-len-lbl\" style=\"color:var(--primary);font-weight:700;\">20</span>\n                </div>\n                <input type=\"range\" id=\"gen-len\" min=\"8\" max=\"64\" value=\"20\" style=\"accent-color:var(--primary);width:100%;cursor:pointer;\" />\n              </div>\n              <div style=\"display:flex;flex-direction:column;gap:0.5rem;font-size:0.9rem;\">\n                <label><input type=\"checkbox\" id=\"g-upper\" checked /> Uppercase (A-Z)</label>\n                <label><input type=\"checkbox\" id=\"g-lower\" checked /> Lowercase (a-z)</label>\n                <label><input type=\"checkbox\" id=\"g-nums\" checked /> Numbers (0-9)</label>\n                <label><input type=\"checkbox\" id=\"g-syms\" checked /> Symbols (!@#$%)</label>\n                <label><input type=\"checkbox\" id=\"g-amb\" /> Avoid Ambiguous (1, l, 0, O)</label>\n              </div>\n            </div>\n            <div class=\"modal-footer\">\n              <button class=\"btn btn-secondary\" id=\"gen-done\">Done</button>\n              <button class=\"btn btn-primary\" id=\"btn-copy-gen-2\">📋 Copy Password</button>\n            </div>\n          </div>\n        </div>\n      `;\n\n      const display = document.getElementById('gen-display');\n      const lenSlider = document.getElementById('gen-len');\n      const lenLbl = document.getElementById('gen-len-lbl');\n      const sBox = document.getElementById('gen-strength-box');\n\n      const doGen = () => {\n        const pwd = generateSecurePassword({\n          length: parseInt(lenSlider.value, 10),\n          useUpper: document.getElementById('g-upper').checked,\n          useLower: document.getElementById('g-lower').checked,\n          useNumbers: document.getElementById('g-nums').checked,\n          useSymbols: document.getElementById('g-syms').checked,\n          avoidAmbiguous: document.getElementById('g-amb').checked\n        });\n        display.textContent = pwd;\n        lenLbl.textContent = lenSlider.value;\n        const s = evaluateStrength(pwd);\n        sBox.innerHTML = `\n          <div class=\"strength-meter\">\n            <div class=\"strength-bar strong\"></div>\n            <div class=\"strength-bar strong\"></div>\n            <div class=\"strength-bar strong\"></div>\n            <div class=\"strength-bar ${s.score >= 4 ? 'strong' : ''}\"></div>\n          </div>\n          <div style=\"display:flex;justify-content:space-between;font-size:0.75rem;margin-top:2px;\">\n            <span style=\"color:${s.color}\">${s.label}</span>\n            <span style=\"color:var(--text-muted)\">~${s.bits} bits entropy</span>\n          </div>`;\n      };\n\n      lenSlider.oninput = doGen;\n      ['g-upper', 'g-lower', 'g-nums', 'g-syms', 'g-amb'].forEach(id => {\n        document.getElementById(id).onchange = doGen;\n      });\n      document.getElementById('btn-regen').onclick = doGen;\n\n      const copyAction = () => {\n        navigator.clipboard.writeText(display.textContent);\n        showToast('Password copied to clipboard!');\n      };\n      document.getElementById('btn-copy-gen').onclick = copyAction;\n      document.getElementById('btn-copy-gen-2').onclick = copyAction;\n\n      const close = () => { modalCont.innerHTML = ''; };\n      document.getElementById('gen-modal-close').onclick = close;\n      document.getElementById('gen-done').onclick = close;\n      document.getElementById('gen-modal-overlay').onclick = close;\n\n      doGen();\n    }\n\n    function openAuditModal() {\n      const modalCont = document.getElementById('modal-container');\n      const weak = [];\n      const pwdMap = {};\n      state.items.forEach(i => {\n        if (i.category === 'logins' && i.password) {\n          if (i.password.length < 12) weak.push(i);\n          if (!pwdMap[i.password]) pwdMap[i.password] = [];\n          pwdMap[i.password].push(i);\n        }\n      });\n      const reused = Object.values(pwdMap).filter(g => g.length > 1);\n\n      modalCont.innerHTML = `\n        <div class=\"modal-overlay\" id=\"audit-modal-overlay\">\n          <div class=\"modal-card\" onclick=\"event.stopPropagation()\" style=\"max-width:580px;\">\n            <div class=\"modal-header\">\n              <span>🛡️ Security Health Check</span>\n              <button class=\"btn-icon\" id=\"audit-close\">✕</button>\n            </div>\n            <div class=\"modal-body\">\n              <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;\">\n                <div style=\"background:var(--bg-input);padding:1rem;border-radius:var(--radius-md);text-align:center;\">\n                  <div style=\"font-size:1.5rem;font-weight:700;color:${weak.length > 0 ? 'var(--danger)' : 'var(--primary)'}\">${weak.length}</div>\n                  <div style=\"font-size:0.8rem;color:var(--text-muted)\">Weak Passwords</div>\n                </div>\n                <div style=\"background:var(--bg-input);padding:1rem;border-radius:var(--radius-md);text-align:center;\">\n                  <div style=\"font-size:1.5rem;font-weight:700;color:${reused.length > 0 ? 'var(--warning)' : 'var(--primary)'}\">${reused.length}</div>\n                  <div style=\"font-size:0.8rem;color:var(--text-muted)\">Reused Groups</div>\n                </div>\n              </div>\n\n              ${weak.length === 0 && reused.length === 0 ? `\n                <div style=\"background:rgba(16,185,129,0.1);border:1px solid var(--primary);padding:1rem;border-radius:var(--radius-md);color:var(--primary);text-align:center;\">\n                  ✓ Excellent! All passwords are strong and unique.\n                </div>\n              ` : `\n                ${weak.length > 0 ? `\n                  <div>\n                    <h4 style=\"color:var(--danger);font-size:0.9rem;margin-bottom:0.5rem;\">⚠️ Weak Passwords (&lt; 12 chars)</h4>\n                    <div style=\"display:flex;flex-direction:column;gap:0.5rem;\">\n                      ${weak.map(w => `\n                        <div style=\"display:flex;justify-content:space-between;align-items:center;background:var(--bg-input);padding:0.65rem 0.85rem;border-radius:var(--radius-md);\">\n                          <span><strong>${escapeHtml(w.title)}</strong> (${w.password.length} chars)</span>\n                          <button class=\"btn btn-secondary\" style=\"padding:0.25rem 0.5rem;font-size:0.8rem;\" data-audit-edit=\"${w.id}\">Change</button>\n                        </div>\n                      `).join('')}\n                    </div>\n                  </div>\n                ` : ''}\n\n                ${reused.length > 0 ? `\n                  <div style=\"margin-top:1rem;\">\n                    <h4 style=\"color:var(--warning);font-size:0.9rem;margin-bottom:0.5rem;\">⚠️ Reused Across Accounts</h4>\n                    ${reused.map(g => `\n                      <div style=\"background:var(--bg-input);border:1px solid rgba(245,158,11,0.3);padding:0.75rem;border-radius:var(--radius-md);margin-bottom:0.5rem;\">\n                        <div style=\"font-size:0.8rem;color:var(--warning);margin-bottom:0.35rem;\">Used by ${g.length} services:</div>\n                        ${g.map(i => `<div style=\"font-size:0.85rem;padding:2px 0;\">• ${escapeHtml(i.title)}</div>`).join('')}\n                      </div>\n                    `).join('')}\n                  </div>\n                ` : ''}\n              `}\n            </div>\n            <div class=\"modal-footer\">\n              <button class=\"btn btn-secondary\" id=\"audit-done\">Close</button>\n            </div>\n          </div>\n        </div>\n      `;\n\n      const close = () => { modalCont.innerHTML = ''; };\n      document.getElementById('audit-close').onclick = close;\n      document.getElementById('audit-done').onclick = close;\n      document.getElementById('audit-modal-overlay').onclick = close;\n\n      document.querySelectorAll('[data-audit-edit]').forEach(b => {\n        b.onclick = () => {\n          const item = state.items.find(i => i.id === b.getAttribute('data-audit-edit'));\n          close();\n          openItemModal(item);\n        };\n      });\n    }\n\n    function openSettingsModal() {\n      const modalCont = document.getElementById('modal-container');\n      modalCont.innerHTML = `\n        <div class=\"modal-overlay\" id=\"settings-overlay\">\n          <div class=\"modal-card\" onclick=\"event.stopPropagation()\" style=\"max-width:540px;\">\n            <div class=\"modal-header\">\n              <span>⚙️ Settings & Backup</span>\n              <button class=\"btn-icon\" id=\"set-close\">✕</button>\n            </div>\n            <div class=\"modal-body\">\n              <div class=\"form-group\">\n                <label class=\"form-label\">Auto-Lock Inactivity Timer</label>\n                <select id=\"set-autolock\" class=\"form-select\">\n                  <option value=\"5\" ${state.autoLockMinutes === 5 ? 'selected' : ''}>5 minutes</option>\n                  <option value=\"15\" ${state.autoLockMinutes === 15 ? 'selected' : ''}>15 minutes (default)</option>\n                  <option value=\"30\" ${state.autoLockMinutes === 30 ? 'selected' : ''}>30 minutes</option>\n                  <option value=\"0\" ${state.autoLockMinutes === 0 ? 'selected' : ''}>Never</option>\n                </select>\n              </div>\n\n              <hr style=\"border-color:var(--border-color);\" />\n\n              <div>\n                <h4 style=\"font-size:0.95rem;font-weight:600;margin-bottom:0.35rem;\">Backup & Export</h4>\n                <p style=\"font-size:0.8rem;color:var(--text-muted);margin-bottom:0.75rem;\">\n                  Export encrypted JSON backup. Safe to store anywhere because it stays AES-GCM encrypted.\n                </p>\n                <button class=\"btn btn-secondary\" id=\"btn-export-backup\">⬇️ Export Encrypted Vault (.json)</button>\n              </div>\n\n              <hr style=\"border-color:var(--border-color);\" />\n\n              <div style=\"border:1px solid var(--danger);background:var(--danger-light);padding:1rem;border-radius:var(--radius-md);\">\n                <h4 style=\"color:var(--danger);font-size:0.95rem;font-weight:700;margin-bottom:0.35rem;\">Danger Zone: Wipe Vault</h4>\n                <p style=\"font-size:0.8rem;color:var(--text-primary);margin-bottom:0.75rem;\">\n                  Permanently delete all stored passwords and reset this browser's IndexedDB.\n                </p>\n                <button class=\"btn btn-danger\" id=\"btn-wipe-vault\">🗑️ Wipe Everything</button>\n              </div>\n            </div>\n            <div class=\"modal-footer\">\n              <button class=\"btn btn-secondary\" id=\"set-done\">Close</button>\n            </div>\n          </div>\n        </div>\n      `;\n\n      document.getElementById('set-autolock').onchange = async (e) => {\n        state.autoLockMinutes = parseInt(e.target.value, 10);\n        state.meta.autoLockMinutes = state.autoLockMinutes;\n        await saveStoredMeta(state.meta);\n        showToast('Auto-lock timer updated.');\n      };\n\n      document.getElementById('btn-export-backup').onclick = async () => {\n        const encrypted = await getStoredItems();\n        const backup = {\n          app: 'OfflinePasswordManager',\n          salt: state.meta.salt,\n          canary: state.meta.canary,\n          items: encrypted,\n          exportedAt: new Date().toISOString()\n        };\n        const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });\n        const a = document.createElement('a');\n        a.href = URL.createObjectURL(blob);\n        a.download = `vault-backup-${new Date().toISOString().slice(0, 10)}.json`;\n        a.click();\n        showToast('Backup file downloaded!');\n      };\n\n      document.getElementById('btn-wipe-vault').onclick = async () => {\n        if (confirm('DANGER: Permanently wipe all data? This cannot be undone!')) {\n          await clearAllStoredData();\n          state.masterKey = null;\n          state.items = [];\n          state.meta = null;\n          state.vaultStatus = 'uninitialized';\n          modalCont.innerHTML = '';\n          render();\n          showToast('Vault wiped and reset.');\n        }\n      };\n\n      const close = () => { modalCont.innerHTML = ''; };\n      document.getElementById('set-close').onclick = close;\n      document.getElementById('set-done').onclick = close;\n      document.getElementById('settings-overlay').onclick = close;\n    }\n\n    // Launch app\n    initVault();\n  </script>\n</body>\n</html>\n","Description":"Create completely self-contained zero-dependency offline web app HTML file","Overwrite":true,"TargetFile":"C:\\Users\\vijay\\.gemini\\antigravity\\scratch\\offline-password-manager\\offline-vault.html","toolAction":"Creating offline-vault.html","toolSummary":"Create offline-vault.html"}}]}
